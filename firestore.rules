rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net for unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(campaignId);
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(productId);
    }

    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(orderId);
    }
  }
}
